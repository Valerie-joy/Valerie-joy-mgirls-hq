# Copy to `.env` and fill in. Only VITE_-prefixed values reach the browser,
# so NEVER put a secret key here — publishable keys only.
#
# Base path. Leave unset for Vercel, Netlify or a GitHub Pages *user* site.
# For a Pages *project* site set it to "/<repo-name>/".
# VITE_BASE=/mgirls-hq/

# Stripe publishable key (pk_...). The secret key lives in the host's
# environment variables, never in this project.
# VITE_STRIPE_PUBLISHABLE_KEY=

# Email / SMS list id from Klaviyo or ConvertKit.
# VITE_NEWSLETTER_LIST_ID=

# Where the application and contact forms POST once a service is connected.
# VITE_FORM_ENDPOINT=
